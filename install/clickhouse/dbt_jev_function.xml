        </argument>
        <argument>
            <type>Nullable(String)</type>
            <name>right</name>
        </argument>
        <argument>
            <type>String</type>
            <name>instructions</name>
        </argument>
        <argument>
            <type>String</type>
            <name>criteria</name>
        </argument>
        <format>JSONEachRow</format>
        <command>dbt_jev_clickhouse_udf</command>
        <execute_direct>true</execute_direct>
        <pool_size>4</pool_size>
        <max_command_execution_time>35</max_command_execution_time>
        <command_read_timeout>35000</command_read_timeout>
        <command_write_timeout>35000</command_write_timeout>
        <command_termination_timeout>5</command_termination_timeout>
        <deterministic>false</deterministic>
        <check_exit_code>true</check_exit_code>
        <stderr_reaction>log_last</stderr_reaction>
    </function>
